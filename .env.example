# Copy to .env and fill in. .env is gitignored — never commit it.
# This file feeds the Python scripts; the Next.js app has its OWN env file at
# dashboard/.env.local (same Zoho + Supabase values, may hold its own token).

# --- Zoho (Sunrooof org) ---
# From api-console.zoho.in -> Self Client. Zoho allows exactly ONE Self Client
# per account — never create a second; reuse it and generate new grant codes
# (grant codes expire in ~3 minutes, refresh tokens never expire).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Filled in by scripts/get_refresh_token.py
ZOHO_REFRESH_TOKEN=

# Your data centre. One of: com, in, eu, com.au, jp
# Check the domain you use to log into Zoho CRM.
ZOHO_DC=in

# --- Zoho Session Cookie (Bypass Ozonotel) ---
# Copy the entire 'Cookie' request header from your browser when logged into Zoho CRM
# This allows downloading the audio via the phonebridge proxy URL.
# NOTE: this cookie EXPIRES every few days/weeks — when audio downloads or
# dashboard playback break, re-copy it from DevTools -> Network. The durable
# fix is real Ozonetel API credentials (support ticket), never obtained so far.
ZOHO_COOKIE=

# --- Sarvam (not needed for discovery) ---
SARVAM_API_KEY=

# --- Supabase (call data storage) ---
# From your Supabase project: Project URL is https://<project-ref>.supabase.co
# (project-ref is in your dashboard URL). Secret key is on the project's
# Settings -> API Keys page (labeled "Secret key", or "service_role" on
# older projects) -- NOT the Publishable/anon key.
# Run dashboard/supabase-schema.sql once in the SQL Editor before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (free model for call summarization) ---
# Get a key at openrouter.ai/keys. Using openai/gpt-oss-20b:free (zero cost,
# rate-limited to 50 requests/day without any credit purchase). Free-model
# availability on OpenRouter shifts over time — see scripts/summarize_calls.py
# if this specific model stops working.
OPENROUTER_API_KEY=

# --- OpenAI (call summarization) ---
# Get a key at platform.openai.com/api-keys. This is the default provider;
# OPENROUTER_API_KEY above is only used as a fallback when this is empty.
# Optional: SUMMARY_MODEL (default gpt-4.1-mini), SUMMARY_DAILY_LIMIT,
# SUMMARY_MIN_INTERVAL, SUMMARY_PROVIDER (openai|openrouter).
OPENAI_API_KEY=

# OpenAI Admin key (sk-admin-...) — org Usage/Costs API only, NOT for inference.
# Read-only admin scope is enough (needs api.usage.read). Leave blank if unused.
OPENAI_ADMIN_KEY=
