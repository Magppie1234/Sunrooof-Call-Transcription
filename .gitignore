# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
.zoho_token_cache.json

# Runtime junk
*.log
*.pid
.DS_Store

# Discovery output (may contain customer data)
out/
recordings/
*.mp3
*.wav

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-win/

# Regenerable dashboard exports — rebuilt from Supabase by
# export_qa_audits_for_dashboard.py in seconds with no API calls. At 60 MB this
# is past GitHub's warning threshold and would re-enter history on every refresh.
ci-dashboard/src/data/real/qa_audits.json

# Derived by scripts/build_slim_dataset.py from the two snapshots above, in
# about a minute and with no API calls. Ignored for the same reason, and for one
# more: they are duplicates. dataset.slim.json is 23 MB of data already committed
# inside dataset.json, and public/data/detail/ is 6,253 files totalling 82 MB —
# a `git add -A` would put all of it in history, then re-enter it whole on every
# refresh, because a regenerated JSON file differs everywhere or nowhere.
# Regenerate with `python scripts/build_slim_dataset.py`; from Sunday the detail
# files are superseded by GET /api/call/[id] against call_detail.
ci-dashboard/src/data/real/dataset.slim.json
ci-dashboard/src/data/real/qa_audits.slim.json
ci-dashboard/public/data/detail/

# Stale 209 MB duplicate of the dashboard, kept on disk pending a decision on it.
# Its docs/ are byte-identical to ci-dashboard/docs/, which IS tracked.
ci-dashboard-demo/
